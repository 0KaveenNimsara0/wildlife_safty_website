{
  "name": "wildlife-safty-web-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace @wildlife/main-frontend",
    "build": "npm run build:main && npm run build:admin",
    "lint": "eslint .",
    "preview": "npm run preview --workspace @wildlife/main-frontend",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:user": "cypress run --spec cypress/e2e/user.cy.js",
    "cy:admin": "cypress run --config baseUrl=http://localhost:5174 --spec cypress/e2e/admin.cy.js",
    "cy:medical": "cypress run --spec cypress/e2e/medical.cy.js",
    "dev:admin": "npm run dev --workspace @wildlife/admin-frontend",
    "build:main": "npm run build --workspace @wildlife/main-frontend",
    "build:admin": "npm run build --workspace @wildlife/admin-frontend",
    "test:architecture": "node --test packages/shared/src/features/auth/session.test.js && node scripts/check-boundaries.mjs",
    "preview:admin": "npm run preview --workspace @wildlife/admin-frontend"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "date-fns": "^4.1.0",
    "firebase": "^12.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.535.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "cypress": "^16.2.1",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^8.0.8"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
